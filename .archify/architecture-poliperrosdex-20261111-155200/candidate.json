  "cards": [
    {
      "dot": "emerald",
      "title": "Patrón MVVM & UI",
      "items": [
        "Vistas desacopladas mediante hooks ViewModel (useCaptura, usePokedex, useMapa)",
        "ApodoContext provee identidad reactiva del entrenador a nivel de árbol React",
        "Renderizado de mapa interactivo Leaflet / OSM mediante WebView aislado"
      ]
    },
    {
      "dot": "cyan",
      "title": "Flujo de Captura & Sensores",
      "items": [
        "Acelerómetro detecta caída libre (<0.35g) e impacto (>2.2g) simulando lanzamiento",
        "AbortController cancela la transacción en curso si el dispositivo se cae",
        "Ubicación GPS precisa obtenida vía expo-location para geolocalizar el avistamiento"
      ]
    },
    {
      "dot": "violet",
      "title": "Capa de Datos & Supabase",
      "items": [
        "AvistamientosRepository ejecuta operación en 2 fases: Storage y base de datos",
        "PerrosRepository transforma filas de Postgres a modelos puros de dominio",
        "EntrenadorRepository almacena el apodo localmente en apodo.txt vía expo-file-system"
      ]
    }
  ]
